# Supabase — Settings → API in your Supabase project (the publishable/anon key, never the secret key)
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Backend base URL. Leave empty in dev — the Vite proxy forwards /api to the backend.
VITE_API_URL=

# Optional: where the Vite dev proxy sends /api (default http://localhost:8000)
# BACKEND_URL=

# Optional: enables the "Pushmeldingen" toggle. Same value as the backend's
# VAPID_PUBLIC_KEY (backend/.env.example) — generate that first, this is just
# the public half. Leave empty and push is simply not offered.
VITE_VAPID_PUBLIC_KEY=
