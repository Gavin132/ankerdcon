# Supabase — from your Supabase project's Settings → API page
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SECRET_KEY=your_service_role_or_secret_key
# Optional but recommended — enables fast local JWT verification (Settings → API → JWT Settings).
# If left empty, the backend falls back to a network call to Supabase Auth on every request.
SUPABASE_JWT_SECRET=yourkey

# Discord integrations (optional)
DISCORD_WEBHOOK_URL=
DISCORD_BOT_TOKEN=
APP_URL=

# Secret in the calendar subscription link (Agenda → "Abonneren"). Leave empty to
# derive it from SUPABASE_JWT_SECRET; set any new value to invalidate every
# link that's been shared.
CALENDAR_FEED_TOKEN=

# Interactive API docs at /api/docs. Set to true in your local .env if you
# want them; keep false anywhere reachable from the internet.
API_DOCS_ENABLED=false

# CORS — comma-separated list of allowed origins
CORS_ORIGINS=http://localhost:5173

# MinIO (self-hosted, S3-compatible) — event-day photo stories.
# See docs/minio-setup.md for how to stand this up. Host only for
# MINIO_ENDPOINT (no https:// prefix) — leave everything blank until then,
# every other story feature (viewing, seen-tracking) works without it.
MINIO_ENDPOINT=
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET=story-photos
MINIO_SECURE=true

# Web push — a second notification channel next to Discord DMs, for members
# who don't check Discord or signed up with Google. Generate ONCE and never
# rotate afterwards (see docs/deployment.md#web-push):
#   python -c "from py_vapid import Vapid02; import base64; v=Vapid02(); v.generate_keys(); \
#     pub=v.public_key.public_bytes(__import__('cryptography.hazmat.primitives.serialization',fromlist=['Encoding']).Encoding.X962, __import__('cryptography.hazmat.primitives.serialization',fromlist=['PublicFormat']).PublicFormat.UncompressedPoint); \
#     priv=v.private_key.private_numbers().private_value.to_bytes(32,'big'); \
#     e=lambda b: base64.urlsafe_b64encode(b).rstrip(b'=').decode(); \
#     print('VAPID_PUBLIC_KEY='+e(pub)); print('VAPID_PRIVATE_KEY='+e(priv))"
# VAPID_PUBLIC_KEY also goes in frontend/.env as VITE_VAPID_PUBLIC_KEY (it's
# public — sent to every browser as part of the subscribe call).
# Leave everything below blank until you've done this: push is then simply
# not offered, nothing else is affected.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com
