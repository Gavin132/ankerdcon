# Supabase — from your Supabase project's Settings → API page
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SECRET_KEY=your_service_role_or_secret_key
# Optional but recommended — enables fast local JWT verification (Settings → API → JWT Settings).
# If left empty, the backend falls back to a network call to Supabase Auth on every request.
SUPABASE_JWT_SECRET=yourkey

# Discord integrations (optional)
DISCORD_WEBHOOK_URL=
DISCORD_BOT_TOKEN=
APP_URL=

# CORS — comma-separated list of allowed origins
CORS_ORIGINS=http://localhost:5173

# MinIO (self-hosted, S3-compatible) — event-day photo stories.
# See docs/minio-setup.md for how to stand this up. Host only for
# MINIO_ENDPOINT (no https:// prefix) — leave everything blank until then,
# every other story feature (viewing, seen-tracking) works without it.
MINIO_ENDPOINT=
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET=story-photos
MINIO_SECURE=true
